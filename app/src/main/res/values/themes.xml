<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Alfred" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary (Gold) -->
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryVariant">@color/gold_primary_variant</item>
        <item name="colorOnPrimary">@color/gold_on_primary</item>

        <!-- Secondary (Blue) -->
        <item name="colorSecondary">@color/blue_accent</item>
        <item name="colorSecondaryVariant">@color/blue_accent_variant</item>
        <item name="colorOnSecondary">@color/blue_on_accent</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/status_error</item>

        <!-- Status bar & nav bar -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
